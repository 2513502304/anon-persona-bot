{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 240
    }
  },
  "crons": [],
  "daemons": {
    "qq-gateway": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": {
        "pdx1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 120,
      "livenessProbe": {
        "httpGet": {
          "port": 1234,
          "path": "/health"
        },
        "initialDelaySeconds": 10
      }
    }
  }
}
